
@implements IDisposable

@using HospitalAppointment.Client.Services
@using Microsoft.AspNetCore.Components.Routing

@inject AuthApiService AuthService
@inject NavigationManager Navigation

<div class="sidebar">

    <div class="sidebar-brand">
        <div class="brand-icon">+</div>
        <div>
            <strong>Hospital</strong>
            <span>Appointment System</span>
        </div>
    </div>

    @if (AuthService.IsLoggedIn &&
         string.Equals(AuthService.CurrentUser?.Role, "Nurse",
             StringComparison.OrdinalIgnoreCase))
    {
        <div class="menu-section">
            <span class="menu-label">NURSE WORKSPACE</span>

            <NavLink href="/nurse/dashboard"
                     Match="NavLinkMatch.All"
                     class="menu-link">
                <span class="menu-icon">▦</span>
                <span>Dashboard</span>
            </NavLink>

            <NavLink href="/nurse/dashboard"
                     class="menu-link">
                <span class="menu-icon">☷</span>
                <span>Waiting Patients</span>
            </NavLink>
        </div>

        <div class="sidebar-user">
            <div class="user-avatar">N</div>
            <div class="user-details">
                <strong>@AuthService.CurrentUser?.FullName</strong>
                <span>Nurse</span>
            </div>
        </div>

        <button class="sidebar-logout" @onclick="Logout">
            <span>↪</span> Logout
        </button>
    }
    else if (AuthService.IsLoggedIn &&
             string.Equals(AuthService.CurrentUser?.Role,
                 "MedicalServiceManager",
                 StringComparison.OrdinalIgnoreCase))
    {
        <div class="menu-section">
            <span class="menu-label">MANAGEMENT</span>

            <NavLink href="/manager/departments"
                     class="menu-link">
                <span class="menu-icon">▦</span>
                <span>Departments</span>
            </NavLink>

            <NavLink href="/manager/medical-services"
                     class="menu-link">
                <span class="menu-icon">✚</span>
                <span>Medical Services</span>
            </NavLink>
        </div>

        <div class="sidebar-user">
            <div class="user-avatar">M</div>
            <div class="user-details">
                <strong>@AuthService.CurrentUser?.FullName</strong>
                <span>Medical Service Manager</span>
            </div>
        </div>

        <button class="sidebar-logout" @onclick="Logout">
            <span>↪</span> Logout
        </button>
    }
    else if (AuthService.IsLoggedIn &&
             string.Equals(AuthService.CurrentUser?.Role,
                 "SchedulingManager",
                 StringComparison.OrdinalIgnoreCase))
    {
        <div class="menu-section">
            <span class="menu-label">SCHEDULING</span>

            <NavLink href="/manager/schedules"
                     class="menu-link">
                <span class="menu-icon">▦</span>
                <span>Schedule Management</span>
            </NavLink>
        </div>

        <div class="sidebar-user">
            <div class="user-avatar">S</div>
            <div class="user-details">
                <strong>@AuthService.CurrentUser?.FullName</strong>
                <span>Scheduling Manager</span>
            </div>
        </div>

        <button class="sidebar-logout" @onclick="Logout">
            <span>↪</span> Logout
        </button>
    }
    else
    {
        <div class="menu-section">
            <span class="menu-label">ACCOUNT</span>

            <NavLink href="/login"
                     Match="NavLinkMatch.All"
                     class="menu-link">
                <span class="menu-icon">↪</span>
                <span>Login</span>
            </NavLink>
        </div>
    }

</div>

<style>
    .sidebar {
        height: 100%;
        min-height: 100vh;
        background: #0f1f46;
        color: white;
        display: flex;
        flex-direction: column;
        padding: 22px 15px;
        box-sizing: border-box;
    }

    .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 8px 10px 27px;
        border-bottom: 1px solid rgba(255,255,255,.12);
    }

    .brand-icon {
        width: 39px;
        height: 39px;
        border-radius: 9px;
        background: #2563eb;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 27px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .sidebar-brand strong,
    .sidebar-brand span {
        display: block;
    }

    .sidebar-brand strong {
        font-size: 17px;
    }

    .sidebar-brand span {
        font-size: 10px;
        color: #a5b4fc;
        margin-top: 4px;
    }

    .menu-section {
        margin-top: 30px;
    }

    .menu-label {
        display: block;
        padding: 0 12px;
        margin-bottom: 12px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.2px;
    }

    .menu-link {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 12px;
        margin: 5px 0;
        color: #cbd5e1;
        text-decoration: none;
        border-radius: 7px;
        font-size: 14px;
        transition: .2s;
    }

    .menu-link:hover {
        background: rgba(255,255,255,.08);
        color: white;
    }

    .menu-link.active {
        background: #2563eb;
        color: white;
    }

    .menu-icon {
        width: 20px;
        text-align: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .sidebar-user {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-top: auto;
        padding: 17px 8px;
        border-top: 1px solid rgba(255,255,255,.12);
    }

    .user-avatar {
        width: 37px;
        height: 37px;
        border-radius: 50%;
        background: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        flex-shrink: 0;
    }

    .user-details {
        min-width: 0;
    }

    .user-details strong,
    .user-details span {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .user-details strong {
        font-size: 12px;
    }

    .user-details span {
        color: #94a3b8;
        font-size: 11px;
        margin-top: 3px;
    }

    .sidebar-logout {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: transparent;
        border: none;
        color: #fca5a5;
        cursor: pointer;
        font-size: 14px;
        border-radius: 7px;
        text-align: left;
        width: 100%;
    }

    .sidebar-logout:hover {
        background: rgba(255,255,255,.08);
    }
</style>

@code {
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
