@inherits LayoutComponentBase
@implements IDisposable
@inject AuthSession Session
@inject NavigationManager Nav

<div class="app-layout">

    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <main class="app-main">
        <div class="app-topbar">
            <span>Hospital Appointment Management System</span>

            <div class="app-topbar-actions">
                @if (Session.IsAuthenticated)
                {
                    if (Session.IsInRole("Patient"))
                    {
                        <NavLink href="book-appointment">Đặt lịch khám</NavLink>
                    }

                    <a href="#" @onclick="SignOutAsync" @onclick:preventDefault>
                        Đăng xuất (@Session.Current!.FullName)
                    </a>
                }
                else
                {
                    <NavLink href="login">Đăng nhập</NavLink>
                    <NavLink href="register">Đăng ký</NavLink>
                }
            </div>
        </div>

        <div class="app-content">
            @Body
        </div>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        await Session.InitializeAsync();
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();
        Nav.NavigateTo("");
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}

<style>
    .app-layout {
        display: flex;
        min-height: 100vh;
    }

    .app-sidebar {
        width: 250px;
        flex-shrink: 0;
    }

    .app-main {
        flex: 1;
        min-width: 0;
        background: #f8fafc;
    }

    .app-topbar {
        height: 65px;
        background: white;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 25px;
        color: #64748b;
        font-size: 13px;
    }

    .app-topbar-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .app-content {
        min-width: 0;
    }

    @@media (max-width: 750px) {
        .app-sidebar {
            width: 190px;
        }
    }

    @@media (max-width: 550px) {
        .app-layout {
            flex-direction: column;
        }

        .app-sidebar {
            width: 100%;
            min-height: auto;
        }

        .app-sidebar .sidebar {
            min-height: auto;
        }

        .sidebar-user {
            margin-top: 20px;
        }
    }
</style>
