@code {

    private List<DoctorScheduleDto> schedules = new();
    private List<DoctorOptionDto> doctors = new();
    private List<DepartmentOptionDto> assignedDepartments = new();
    private List<HospitalAppointment.Client.Models.Department.DepartmentDto> allDepartments = new();

    private int selectedFormDoctorId;
    private int selectedFormDepartmentId;

    private int filterDoctorId;
    private int filterDepartmentId;

    private int slotDuration = 60;

    private int? editingId;
    private int? updatingId;

    private DateTime formDate = DateTime.Today;

    private TimeOnly formStartTime = new(8, 0);
    private TimeOnly formEndTime = new(11, 0);

    // Week navigation
    private DateTime currentWeekStart = GetStartOfWeek(DateTime.Today);

    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string formError = string.Empty;

    private bool showForm;
    private bool isLoading;
    private bool isSaving;

    private static DateTime GetStartOfWeek(DateTime dt)
    {
        int diff = (7 + (dt.DayOfWeek - DayOfWeek.Monday)) % 7;
        return dt.Date.AddDays(-1 * diff);
    }

    private DateTime[] DaysOfWeek => Enumerable.Range(0, 7)
        .Select(i => currentWeekStart.AddDays(i))
        .ToArray();

    private string WeekRangeText =>
        $"{currentWeekStart:dd/MM/yyyy} - {currentWeekStart.AddDays(6):dd/MM/yyyy}";

    private void PreviousWeek()
    {
        currentWeekStart = currentWeekStart.AddDays(-7);
    }

    private void NextWeek()
    {
        currentWeekStart = currentWeekStart.AddDays(7);
    }

    private IEnumerable<DoctorOptionDto> DisplayedDoctors
    {
        get
        {
            var list = doctors.AsEnumerable();

            if (filterDoctorId > 0)
            {
                list = list.Where(d => d.DoctorId == filterDoctorId);
            }

            if (filterDepartmentId > 0)
            {
                var doctorIdsInDept = schedules
                    .Where(s => s.DepartmentId == filterDepartmentId)
                    .Select(s => s.DoctorId)
                    .ToHashSet();

                list = list.Where(d => doctorIdsInDept.Contains(d.DoctorId));
            }

            return list;
        }
    }

    private List<DoctorScheduleDto> GetSlotsForDoctorAndDay(int doctorId, DateTime day)
    {
        var targetDate = DateOnly.FromDateTime(day);
        return schedules
            .Where(s => s.DoctorId == doctorId && s.SlotDate == targetDate)
            .OrderBy(s => s.StartTime)
            .ToList();
    }

    private string GetDoctorDepartmentName(int doctorId)
    {
        var slot = schedules.FirstOrDefault(s => s.DoctorId == doctorId && !string.IsNullOrWhiteSpace(s.DepartmentName));
        if (slot != null)
            return slot.DepartmentName;

        return "";
    }

    private async Task LoadInitialData()
    {
        isLoading = true;

        try
        {
            doctors = await ScheduleService.GetDoctorsAsync();
            allDepartments = await DepartmentService.GetActiveAsync();
        }
        catch (HttpRequestException ex)
        {
            HandleApiError(ex);
        }
        catch (Exception ex)
        {
            errorMessage = string.IsNullOrWhiteSpace(ex.Message) ? "Unable to load schedule data." : ex.Message;
        }
        finally
        {
            isLoading = false;
        }

        await LoadSchedules();
    }

    private async Task LoadSchedules()
    {
        if (isLoading)
            return;

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            int? doctorId = filterDoctorId > 0 ? filterDoctorId : null;
            int? departmentId = filterDepartmentId > 0 ? filterDepartmentId : null;

            schedules = await ScheduleService.GetAllAsync(
                doctorId,
                departmentId,
                null,
                null);

            // Tự động căn chỉnh tuần nếu tuần hiện tại không có dữ liệu nhưng DB có lịch
            if (schedules.Count > 0 && !schedules.Any(s => s.SlotDate >= DateOnly.FromDateTime(currentWeekStart) && s.SlotDate <= DateOnly.FromDateTime(currentWeekStart.AddDays(6))))
            {
                var nearestSlot = schedules
                    .OrderBy(s => Math.Abs((s.SlotDate.ToDateTime(TimeOnly.MinValue) - DateTime.Today).TotalDays))
                    .FirstOrDefault();

                if (nearestSlot != null)
                {
                    currentWeekStart = GetStartOfWeek(nearestSlot.SlotDate.ToDateTime(TimeOnly.MinValue));
                }
            }
        }
        catch (HttpRequestException ex)
        {
            HandleApiError(ex);
        }
        catch (Exception ex)
        {
            errorMessage = string.IsNullOrWhiteSpace(ex.Message) ? "Unable to load schedules." : ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnFormDoctorChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var doctorId))
            return;

        selectedFormDoctorId = doctorId;
        selectedFormDepartmentId = 0;
        assignedDepartments.Clear();

        if (doctorId <= 0)
            return;

        try
        {
            assignedDepartments =
                await ScheduleService.GetDepartmentsByDoctorAsync(doctorId);
        }
        catch (HttpRequestException ex)
        {
            formError = ex.Message;
        }
        catch (Exception ex)
        {
            formError = string.IsNullOrWhiteSpace(ex.Message) ? "Unable to load doctor's departments." : ex.Message;
        }
    }

    private void OpenCreateForm()
    {
        editingId = null;

        selectedFormDoctorId = 0;
        selectedFormDepartmentId = 0;

        assignedDepartments.Clear();

        formDate = DateTime.Today;
        formStartTime = new TimeOnly(8, 0);
        formEndTime = new TimeOnly(11, 0);

        slotDuration = 60;

        formError = string.Empty;
        errorMessage = string.Empty;

        showForm = true;
    }

    private async Task OpenEditForm(DoctorScheduleDto item)
    {
        editingId = item.ScheduleSlotId;

        selectedFormDoctorId = item.DoctorId;
        selectedFormDepartmentId = item.DepartmentId;

        formDate = item.SlotDate.ToDateTime(TimeOnly.MinValue);
        formStartTime = item.StartTime;
        formEndTime = item.EndTime;

        formError = string.Empty;
        errorMessage = string.Empty;

        showForm = true;

        try
        {
            assignedDepartments =
                await ScheduleService.GetDepartmentsByDoctorAsync(item.DoctorId);
        }
        catch (HttpRequestException ex)
        {
            formError = ex.Message;
        }
        catch (Exception ex)
        {
            formError = string.IsNullOrWhiteSpace(ex.Message) ? "Unable to load doctor's departments." : ex.Message;
        }
    }

    private void CloseForm()
    {
        showForm = false;
        editingId = null;
        formError = string.Empty;
    }

    private async Task SaveSchedule()
    {
        if (isSaving)
            return;

        formError = string.Empty;

        if (selectedFormDoctorId <= 0)
        {
            formError = "Please select a doctor.";
            return;
        }

        if (selectedFormDepartmentId <= 0)
        {
            formError = "Please select a department.";
            return;
        }

        var date = DateOnly.FromDateTime(formDate);
        var startTime = formStartTime;
        var endTime = formEndTime;

        if (endTime <= startTime)
        {
            formError = "End time must be later than start time.";
            return;
        }

        if (date < DateOnly.FromDateTime(DateTime.Today))
        {
            formError = "Cannot create or update a schedule in the past.";
            return;
        }

        isSaving = true;

        try
        {
            if (editingId.HasValue)
            {
                var request = new UpdateScheduleDto
                {
                    DoctorId = selectedFormDoctorId,
                    DepartmentId = selectedFormDepartmentId,
                    SlotDate = date,
                    StartTime = startTime,
                    EndTime = endTime
                };

                await ScheduleService.UpdateAsync(
                    editingId.Value,
                    request);

                successMessage = "Schedule updated successfully.";
            }
            else
            {
                var request = new CreateScheduleDto
                {
                    DoctorId = selectedFormDoctorId,
                    DepartmentId = selectedFormDepartmentId,
                    SlotDate = date,
                    StartTime = startTime,
                    EndTime = endTime,
                    SlotDurationMinutes = slotDuration
                };

                var createdSlots = await ScheduleService.CreateAsync(request);

                successMessage =
                    $"Successfully created {createdSlots.Count} schedule slots.";
            }

            showForm = false;
            editingId = null;

            await LoadSchedules();
        }
        catch (HttpRequestException ex)
        {
            if (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/login", true);
                return;
            }
            formError = ex.Message;
        }
        catch (Exception ex)
        {
            formError = string.IsNullOrWhiteSpace(ex.Message) ? "Unable to save schedule." : ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleStatus(DoctorScheduleDto item)
    {
        if (updatingId.HasValue)
            return;

        updatingId = item.ScheduleSlotId;

        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            await ScheduleService.UpdateStatusAsync(
                item.ScheduleSlotId,
                !item.IsActive);

            successMessage = item.IsActive
                ? "Schedule deactivated successfully."
                : "Schedule activated successfully.";

            await LoadSchedules();
        }
        catch (HttpRequestException ex)
        {
            HandleApiError(ex);
        }
        catch (Exception ex)
        {
            errorMessage = string.IsNullOrWhiteSpace(ex.Message) ? "Unable to update schedule status." : ex.Message;
        }
        finally
        {
            updatingId = null;
        }
    }

    private void HandleApiError(HttpRequestException ex)
    {
        if (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        errorMessage = ex.Message;
    }
}
