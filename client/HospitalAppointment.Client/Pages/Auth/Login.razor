2@page "/login"
@inject ApiClient Api
@inject AuthSession Session
@inject NavigationManager Nav

<PageTitle>Đăng nhập</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="h3 mb-3">Đăng nhập</h1>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="logged-in-panel">
                <div class="success-icon">✓</div>

                <h3>Welcome back!</h3>

                <p>
                    @AuthService.CurrentUser.FullName
                </p>

                <div class="user-info">
                    <div>
                        <span>Username</span>
                        <strong>@AuthService.CurrentUser.Username</strong>
                    </div>

                    <div>
                        <span>Role</span>
                        <strong>@AuthService.CurrentUser.Role</strong>
                    </div>
                </div>

                @if (AuthService.CurrentUser.Role == "Nurse")
                        {
                            <button class="login-button"
                                    @onclick="GoToDashboard">
                                Go to Nurse Dashboard
                            </button>
                        }
                        else if (AuthService.CurrentUser.Role == "MedicalServiceManager")
                        {
                            <button class="login-button"
                                    @onclick="GoToDashboard">
                                Go to Department Management
                            </button>
                }
                else if (AuthService.CurrentUser.Role == "SchedulingManager")
                {
                    <button class="login-button"
                            @onclick="GoToDashboard">
                        Go to Schedule Management
                    </button>
                }

                <button class="logout-button"
                        @onclick="Logout">
                    Logout
                </button>
            </div>
        }
        else
        {
            <div class="login-form">
                <h3>Sign in</h3>
                <p class="form-description">
                    Please enter your account information.
                </p>

                <EditForm Model="@loginRequest"
                          OnValidSubmit="@HandleLogin">

                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label>Username or Email</label>

                        <InputText class="form-input"
                                   @bind-Value="loginRequest.UsernameOrEmail"
                                   placeholder="Enter username or email" />

                        <ValidationMessage For="@(() => loginRequest.UsernameOrEmail)" />
                    </div>

                    <div class="form-group">
                        <label>Password</label>

                        <InputText class="form-input"
                                   type="password"
                                   @bind-Value="loginRequest.Password"
                                   placeholder="Enter password" />

                        <ValidationMessage For="@(() => loginRequest.Password)" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="error-message">
                            @errorMessage
                        </div>
                    }

                    <button type="submit"
                            class="login-button"
                            disabled="@isLoading">

                        @if (isLoading)
                        {
                            <span>Signing in...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                        }
                    </button>
                </EditForm>
            </div>
        }

        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label" for="username">Email hoặc tên đăng nhập</label>
                <InputText id="username" class="form-control" @bind-Value="_model.Username" autocomplete="username" />
                <ValidationMessage For="() => _model.Username" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="password">Mật khẩu</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" autocomplete="current-password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            <button class="btn btn-primary w-100" type="submit" disabled="@_busy">
                @(_busy ? "Đang đăng nhập..." : "Đăng nhập")
            </button>
        </EditForm>

        <p class="mt-3">Chưa có tài khoản? <a href="register">Đăng ký</a></p>
    </div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly LoginRequest _model = new();
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (Session.IsAuthenticated)
            Nav.NavigateTo(GetTarget());
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var result = await Api.PostAsync<LoginRequest, AuthResponse>("api/auth/login", _model);
        _busy = false;

        if (!result.IsSuccess || result.Data == null)
        {
            _error = result.ErrorMessage;
            return;
    
    private async Task HandleLogin()
    {
        if (isLoading)
            return;

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var user = await AuthService.LoginAsync(loginRequest);

            if (user == null || string.IsNullOrWhiteSpace(user.Role))
            {
                AuthService.Logout();
                errorMessage = "Unable to identify your account role.";
                return;
            }

            var role = user.Role
                .Trim()
                .Replace(" ", "")
                .ToLowerInvariant();

            switch (role)
            {
                case "nurse":
                    Navigation.NavigateTo("/nurse/dashboard");
                    break;

                case "medicalservicemanager":
                    Navigation.NavigateTo("/manager/departments");
                    break;

                case "schedulingmanager":
                    Navigation.NavigateTo("/manager/schedules");
                    break;

                default:
                    AuthService.Logout();

                    errorMessage = $"Role '{user.Role}' is not authorized.";

                    break;
            }
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "Invalid username or password.";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Cannot connect to API: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Login error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


    private void GoToDashboard()
    {
        switch (AuthService.CurrentUser?.Role?.Trim())
        {
            case "Nurse":
                Navigation.NavigateTo("/nurse/dashboard");
                break;

            case "MedicalServiceManager":
                Navigation.NavigateTo("/manager/departments");
                break;

            case "SchedulingManager":
                Navigation.NavigateTo("/manager/schedules");
                break;

            default:
                AuthService.Logout();
                Navigation.NavigateTo("/login", true);
                break;
        }

        await Session.SignInAsync(result.Data);
        Nav.NavigateTo(GetTarget());
    }

    // Chỉ chấp nhận đường dẫn nội bộ để tránh chuyển hướng sang trang lạ
    private string GetTarget()
    {
        if (!string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//"))
            return ReturnUrl;

        return Session.IsInRole("Patient") ? "book-appointment" : "";
    private void Logout()
    {
        AuthService.Logout();
        loginRequest = new LoginRequestDto();
        errorMessage = string.Empty;
    }
}
