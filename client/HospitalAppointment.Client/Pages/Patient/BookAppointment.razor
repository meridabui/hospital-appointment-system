@page "/book-appointment"
@using HospitalAppointment.Client.Models
@using HospitalAppointment.Client.Core
@using HospitalAppointment.Client.Components
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Đặt lịch khám</PageTitle>

<RoleGuard Role="Patient" OnAuthorized="LoadInitialAsync">
    <PatientHeader ActiveTab="book" />

    <div class="booking-page-container">
        <!-- TITLE -->
        <div class="booking-header">
            <h2 class="booking-title">Đăng ký hẹn khám chuyên khoa</h2>
            <p class="booking-subtitle">Chọn khoa, bác sĩ và khung giờ phù hợp. Yêu cầu sẽ được gửi tới bộ phận Tiếp đón để xác nhận.</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        @if (_result != null)
        {
            <!-- RESULT SUCCESS CARD -->
            <div class="booking-card success-card">
                <div class="success-banner">
                    <div class="success-icon">✓</div>
                    <div>
                        <h4 class="mb-1 text-success">Đã gửi yêu cầu đặt lịch thành công!</h4>
                        <p class="text-muted mb-0">@_result.Message</p>
                    </div>
                </div>

                <div class="summary-details">
                    <div class="summary-row">
                        <span class="summary-label">Mã lịch hẹn:</span>
                        <span class="summary-val text-primary fw-bold">@_result.AppointmentCode</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Trạng thái:</span>
                        <span class="badge bg-warning text-dark">@_result.Status (Chờ tiếp đón xác nhận)</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Chuyên khoa:</span>
                        <span class="summary-val">@_result.DepartmentName</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Bác sĩ:</span>
                        <span class="summary-val">BS. @_result.DoctorName</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">Thời gian:</span>
                        <span class="summary-val">@ViVn.FormatTime(_result.StartTime) - @ViVn.FormatTime(_result.EndTime) &middot; Ngày: @ViVn.FormatDate(_result.Date)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(_result.BookingReason))
                    {
                        <div class="summary-row">
                            <span class="summary-label">Lý do khám:</span>
                            <span class="summary-val fst-italic">“@_result.BookingReason”</span>
                        </div>
                    }
                </div>

                <div class="d-flex gap-3 mt-4">
                    <a href="my-appointments" class="btn btn-primary px-4 py-2">Xem danh sách lịch hẹn</a>
                    <button class="btn btn-outline-secondary px-4 py-2" @onclick="ResetAsync">Đặt thêm lịch khác</button>
                </div>
            </div>
        }
        else
        {
            <div class="booking-card">

                <!-- STEP 1: CHỌN CHUYÊN KHOA -->
                <div class="step-section">
                    <div class="step-title">
                        <span class="step-num">1</span>
                        <span>CHỌN CHUYÊN KHOA TIẾP NHẬN (*)</span>
                    </div>

                    @if (_busy && _departments.Count == 0)
                    {
                        <div class="loading-text">Đang tải danh sách chuyên khoa...</div>
                    }
                    else if (_departments.Count == 0)
                    {
                        <p class="text-muted">Hiện chưa có chuyên khoa nào đang hoạt động.</p>
                    }
                    else
                    {
                        <div class="departments-grid">
                            @foreach (var d in _departments)
                            {
                                var isSelected = _department?.DepartmentId == d.DepartmentId;
                                <div class="dept-card @(isSelected ? "selected" : "")"
                                     @onclick="() => SelectDepartmentAsync(d)">
                                    <div class="dept-header">
                                        <h4 class="dept-name">@d.DepartmentName</h4>
                                    </div>
                                    <p class="dept-desc">
                                        @(string.IsNullOrWhiteSpace(d.Description) ? "Khám và điều trị chuyên sâu theo tiêu chuẩn." : d.Description)
                                    </p>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- STEP 2: CHỌN BÁC SĨ -->
                @if (_department != null)
                {
                    <div class="step-section">
                        <div class="step-title">
                            <span class="step-num">2</span>
                            <span>CHỌN BÁC SĨ PHỤ TRÁCH (*)</span>
                        </div>

                        @if (_loadingDoctors)
                        {
                            <div class="loading-text">Đang tìm bác sĩ khoa @_department.DepartmentName...</div>
                        }
                        else if (_doctors.Count == 0)
                        {
                            <div class="alert alert-info py-2">Chuyên khoa này hiện chưa có bác sĩ nào mở lịch khám.</div>
                        }
                        else
                        {
                            <div class="doctors-grid">
                                @foreach (var doc in _doctors)
                                {
                                    var isSelected = _doctor?.DoctorId == doc.DoctorId;
                                    <div class="doc-card @(isSelected ? "selected" : "")"
                                         @onclick="() => SelectDoctorAsync(doc)">
                                        <div class="doc-avatar">
                                            @GetDoctorInitial(doc.FullName)
                                        </div>
                                        <div class="doc-info">
                                            <div class="doc-name">BS. @doc.FullName</div>
                                            <div class="doc-spec">@(doc.Specialty ?? _department.DepartmentName)</div>
                                            <div class="doc-slots">
                                                @(doc.AvailableSlotCount > 0 ? $"{doc.AvailableSlotCount} khung giờ còn trống" : "Lịch khám theo ca")
                                            </div>
                                        </div>
                                        @if (isSelected)
                                        {
                                            <div class="doc-check">✓</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <!-- STEP 3: CHỌN NGÀY & KHUNG GIỜ -->
                @if (_doctor != null)
                {
                    <div class="step-section">
                        <div class="step-title">
                            <span class="step-num">3</span>
                            <span>CHỌN NGÀY &amp; KHUNG GIỜ KHÁM CÒN TRỐNG (*)</span>
                        </div>

                        <!-- DATE SELECTION -->
                        <div class="mb-3">
                            <label class="field-label">Ngày dự kiến khám:</label>
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <input type="date"
                                       class="date-input"
                                       value="@_selectedDateString"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       @onchange="OnDateInputChanged" />

                                @if (_dates.Count > 0)
                                {
                                    <div class="quick-dates-label text-muted small">Các ngày có lịch trống:</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var d in _dates)
                                        {
                                            var isCurDate = _date?.Date == d.Date;
                                            <button type="button"
                                                    class="quick-date-btn @(isCurDate ? "active" : "")"
                                                    @onclick="() => SelectDateAsync(d)">
                                                @ViVn.FormatDate(d.Date)
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- SLOTS SELECTION -->
                        <div>
                            <label class="field-label">Các khung giờ sẵn sàng tiếp nhận:</label>

                            @if (_loadingSlots)
                            {
                                <div class="loading-text">Đang tải các khung giờ...</div>
                            }
                            else if (_date == null)
                            {
                                <p class="text-muted small">Vui lòng chọn ngày để hiển thị các khung giờ khám.</p>
                            }
                            else if (_slots.Count == 0)
                            {
                                <div class="alert alert-warning py-2 mb-0">Ngày này không còn khung giờ trống. Vui lòng chọn ngày khác.</div>
                            }
                            else
                            {
                                <div class="slots-grid">
                                    @foreach (var s in _slots)
                                    {
                                        var isSelected = _slot?.ScheduleSlotId == s.ScheduleSlotId;
                                        <div class="slot-item @(isSelected ? "selected" : "")"
                                             @onclick="() => SelectSlot(s)">
                                            <div class="slot-time">@ViVn.FormatTime(s.StartTime) - @ViVn.FormatTime(s.EndTime)</div>
                                            <div class="slot-status">CÒN TRỐNG</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- STEP 4: MÔ TẢ LÝ DO KHÁM -->
                <div class="step-section">
                    <div class="step-title">
                        <span class="step-num">4</span>
                        <span>MÔ TẢ LÝ DO KHÁM HOẶC TRIỆU CHỨNG BAN ĐẦU</span>
                    </div>

                    <textarea class="reason-textarea"
                              rows="3"
                              maxlength="500"
                              placeholder="Ví dụ: Đau tức ngực trái 2 hôm nay khi thở sâu, có tiền sử tăng huyết áp..."
                              @bind="_reason"></textarea>
                </div>

                <!-- FOOTER ACTION BAR -->
                <div class="action-footer">
                    <div class="status-note">
                        Lịch hẹn sau khi gửi sẽ có trạng thái <strong>Pending</strong> và được Lễ tân xác nhận.
                    </div>

                    <button class="confirm-btn"
                            disabled="@(!CanSubmit || _busy)"
                            @onclick="SubmitAsync">
                        @(_busy ? "Đang xử lý..." : "Xác Nhận Đặt Lịch Khám")
                    </button>
                </div>

            </div>
        }
    </div>
</RoleGuard>

