@code {
    private const string GenericError = "Đã xảy ra lỗi khi xử lý dữ liệu. Vui lòng thử lại.";

    private bool _busy;
    private bool _loadingDoctors;
    private bool _loadingSlots;
    private string? _error;
    private string? _reason;

    private List<DepartmentDto> _departments = new();
    private List<DoctorListItemDto> _doctors = new();
    private List<AvailableDateDto> _dates = new();
    private List<SlotDto> _slots = new();

    private DepartmentDto? _department;
    private DoctorListItemDto? _doctor;
    private AvailableDateDto? _date;
    private SlotDto? _slot;
    private AppointmentResponse? _result;

    private string _selectedDateString = "";

    private bool CanSubmit => _department != null && _doctor != null && _slot != null;

    private static string GetDoctorInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "D";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts[^1][0].ToString().ToUpperInvariant();
    }

    private async Task LoadInitialAsync()
    {
        await LoadDepartmentsAsync();
    }

    private async Task LoadDepartmentsAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            var res = await Api.GetAsync<List<DepartmentDto>>("api/departments");
            if (res.IsSuccess) _departments = res.Data ?? new();
            else _error = res.ErrorMessage;
        }
        catch (Exception)
        {
            _error = GenericError;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SelectDepartmentAsync(DepartmentDto department)
    {
        _department = department;
        _doctor = null;
        _date = null;
        _slot = null;
        _doctors = new();
        _dates = new();
        _slots = new();
        _selectedDateString = "";
        _error = null;

        _loadingDoctors = true;

        try
        {
            var res = await Api.GetAsync<List<DoctorListItemDto>>($"api/departments/{department.DepartmentId}/doctors");
            if (res.IsSuccess)
            {
                _doctors = res.Data ?? new();
            }
            else
            {
                _error = res.ErrorMessage;
            }
        }
        catch (Exception)
        {
            _error = GenericError;
        }
        finally
        {
            _loadingDoctors = false;
        }
    }

    private async Task SelectDoctorAsync(DoctorListItemDto doctor)
    {
        _doctor = doctor;
        _date = null;
        _slot = null;
        _dates = new();
        _slots = new();
        _selectedDateString = "";
        _error = null;

        _loadingSlots = true;

        try
        {
            var res = await Api.GetAsync<List<AvailableDateDto>>(
                $"api/doctors/{doctor.DoctorId}/available-dates?departmentId={_department!.DepartmentId}");

            if (res.IsSuccess)
            {
                _dates = res.Data ?? new();
                if (_dates.Count > 0)
                {
                    // Chọn ngày gần nhất tự động
                    var firstDate = _dates[0];
                    _selectedDateString = firstDate.Date.ToString("yyyy-MM-dd");
                    await SelectDateAsync(firstDate);
                }
            }
            else
            {
                _error = res.ErrorMessage;
            }
        }
        catch (Exception)
        {
            _error = GenericError;
        }
        finally
        {
            _loadingSlots = false;
        }
    }

    private async Task OnDateInputChanged(ChangeEventArgs e)
    {
        _selectedDateString = e.Value?.ToString() ?? "";
        if (DateOnly.TryParse(_selectedDateString, out var parsedDate))
        {
            var existing = _dates.FirstOrDefault(d => d.Date == parsedDate);
            var target = existing ?? new AvailableDateDto { Date = parsedDate };
            await SelectDateAsync(target);
        }
    }

    private async Task SelectDateAsync(AvailableDateDto date)
    {
        _loadingSlots = true;
        _error = null;
        _slot = null;
        _date = date;
        _selectedDateString = date.Date.ToString("yyyy-MM-dd");

        try
        {
            await LoadSlotsAsync(date);
        }
        catch (Exception)
        {
            _error = GenericError;
        }
        finally
        {
            _loadingSlots = false;
        }
    }

    private async Task<bool> LoadSlotsAsync(AvailableDateDto date)
    {
        var dateText = date.Date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

        var res = await Api.GetAsync<List<SlotDto>>(
            $"api/doctors/{_doctor!.DoctorId}/slots?departmentId={_department!.DepartmentId}&date={dateText}");

        if (!res.IsSuccess)
        {
            _error = res.ErrorMessage;
            return false;
        }

        _slots = res.Data ?? new();
        return true;
    }

    private void SelectSlot(SlotDto slot)
    {
        _error = null;
        _slot = slot;
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit || _busy) return;

        _busy = true;
        _error = null;

        try
        {
            var request = new CreateAppointmentRequest
            {
                DepartmentId = _department!.DepartmentId,
                DoctorId = _doctor!.DoctorId,
                ScheduleSlotId = _slot!.ScheduleSlotId,
                BookingReason = string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim()
            };

            var res = await Api.PostAsync<CreateAppointmentRequest, AppointmentResponse>("api/appointments", request);

            if (res.IsSuccess && res.Data != null)
            {
                _result = res.Data;
                return;
            }

            var message = res.IsSuccess ? GenericError : res.ErrorMessage;

            if (res.StatusCode == 409)
            {
                _slot = null;
                if (_date != null) await LoadSlotsAsync(_date);
            }

            _error = message;
        }
        catch (Exception)
        {
            _error = GenericError;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResetAsync()
    {
        _error = null;
        _reason = null;
        _department = null;
        _doctor = null;
        _date = null;
        _slot = null;
        _result = null;
        _doctors = new();
        _dates = new();
        _slots = new();
        _selectedDateString = "";

        await LoadDepartmentsAsync();
    }
}
