@page "/doctor/completed-patients"
@inject MedicalRecordApiService MedicalRecordApiService

<PageTitle>Completed patients</PageTitle>

<RoleGuard Role="Doctor" OnAuthorized="LoadAsync">
    <div class="container-fluid py-4">
    <div class="mb-4">
                <h2 class="fw-bold text-primary mb-1"><i class="bi bi-clipboard-check me-2"></i>Completed patients</h2>
                <p class="text-muted mb-0">Consultations you have completed.</p>
    </div>

    <div class="card border-0 shadow-sm mb-4"><div class="card-body">
    <div class="row g-2">
        <div class="col-md-7">
            <input class="form-control" placeholder="Search by patient name, patient code or appointment code"
                   aria-label="Search patients" @bind="_keyword" />
        </div>
        <div class="col-md-3">
            <input class="form-control" type="date" aria-label="Appointment date" @bind="_date" />
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-primary" disabled="@_loading" @onclick="LoadAsync">Search</button>
        </div>
    </div>
    </div></div>

    @if (_error is not null)
    {
        <StatusMessage Type="danger" Text="@_error" />
    }
    else if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="text-muted mt-2 mb-0">Loading...</p></div>
    }
    else if (_visits.Count == 0)
    {
        <StatusMessage Text="No completed patients found." />
    }
    else
    {
        <div class="card border-0 shadow-sm"><div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Date</th>
                        <th>Time</th>
                        <th>Appointment</th>
                        <th>Patient</th>
                        <th>Department</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var visit in _visits)
                    {
                        <tr>
                            <td class="ps-3">@visit.SlotDate.ToString("dd/MM/yyyy")</td>
                            <td>@visit.StartTime.ToString("HH:mm") - @visit.EndTime.ToString("HH:mm")</td>
                            <td><span class="badge bg-light text-dark border font-monospace">@visit.AppointmentCode</span></td>
                            <td><div class="fw-semibold">@visit.PatientName</div><div class="small text-muted">@visit.PatientCode</div></td>
                            <td>@visit.DepartmentName</td>
                            <td><a class="btn btn-sm btn-primary" href="doctor/medical-records/@visit.AppointmentId">View EMR</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>
    }
    </div>
</RoleGuard>

@code {
    private List<CompletedVisit> _visits = new();
    private string? _keyword;
    private DateOnly? _date;
    private string? _error;
    private bool _loading = true;

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        var result = await MedicalRecordApiService.GetCompletedAsync(_keyword, _date);
        _loading = false;

        if (result.IsSuccess)
        {
            _visits = result.Data ?? new();
        }
        else
        {
            _error = result.ErrorMessage;
        }
    }
}
