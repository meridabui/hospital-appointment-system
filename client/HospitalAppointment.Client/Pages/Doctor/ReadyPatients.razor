@page "/doctor/ready-patients"
@inject ExaminationApiService ExaminationApiService

<PageTitle>Ready patients</PageTitle>

<RoleGuard Role="Doctor" OnAuthorized="LoadAsync">
    <div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
                <h2 class="fw-bold text-primary mb-1"><i class="bi bi-person-lines-fill me-2"></i>Ready patients</h2>
                <p class="text-muted mb-0">Patients waiting for or currently in consultation.</p>
        </div>
        <button class="btn btn-outline-primary" disabled="@_loading" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>
    </div>

    @if (_error is not null)
    {
        <StatusMessage Type="danger" Text="@_error" />
    }
    else if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="text-muted mt-2 mb-0">Loading...</p></div>
    }
    else if (_patients.Count == 0)
    {
        <StatusMessage Text="No patients are ready for consultation today." />
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4"><div class="card-body">
            <label class="form-label small fw-semibold" for="patient-search">Search patients</label>
            <input id="patient-search" class="form-control" placeholder="Search by patient name, patient code or appointment code"
                   @bind="_search" @bind:event="oninput" />
        </div></div>

        <div class="card border-0 shadow-sm"><div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Time</th>
                        <th>Appointment</th>
                        <th>Patient</th>
                        <th>Department</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in FilteredPatients)
                    {
                        <tr>
                            <td class="ps-3">@patient.StartTime.ToString("HH:mm") - @patient.EndTime.ToString("HH:mm")</td>
                            <td><span class="badge bg-light text-dark border font-monospace">@patient.AppointmentCode</span></td>
                            <td><div class="fw-semibold">@patient.PatientName</div><div class="small text-muted">@patient.PatientCode</div></td>
                            <td>@patient.DepartmentName</td>
                            <td>@patient.BookingReason</td>
                            <td><span class="badge @(patient.Status == InConsultation ? "bg-primary" : "bg-warning text-dark")">@patient.Status</span></td>
                            <td class="text-nowrap">
                                <button class="btn btn-sm btn-primary" @onclick="() => OpenPopup(patient)">View</button>
                                @if (patient.Status == InConsultation)
                                {
                                    <a class="btn btn-sm btn-success" href="doctor/medical-records/@patient.AppointmentId">Create EMR</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>

    }

    @if (_selected is not null)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" role="dialog" aria-modal="true" aria-labelledby="patient-title">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 id="patient-title" class="modal-title h5">@_selected.PatientName</h2>
                        <button class="btn-close" aria-label="Close" disabled="@_starting" @onclick="ClosePopup"></button>
                    </div>
                    <div class="modal-body">
                        @if (_popupError is not null)
                        {
                            <StatusMessage Type="danger" Text="@_popupError" />
                        }
                        <p class="mb-1">Status: <strong>@_selected.Status</strong></p>
                        <p class="mb-1">Patient code: @_selected.PatientCode</p>
                        <p class="mb-1">Date of birth: @(_selected.DateOfBirth?.ToString("dd/MM/yyyy") ?? "-")</p>
                        <p class="mb-1">Gender: @(_selected.Gender ?? "-")</p>
                        <p class="mb-1">Phone: @(_selected.Phone ?? "-")</p>
                        <p class="mb-1">Address: @(_selected.Address ?? "-")</p>
                        <p class="mb-1">Appointment: @_selected.AppointmentCode, @_selected.SlotDate.ToString("dd/MM/yyyy")</p>
                        <p class="mb-1">Time: @_selected.StartTime.ToString("HH:mm") - @_selected.EndTime.ToString("HH:mm")</p>
                        <p class="mb-1">Department: @_selected.DepartmentName</p>
                        <p class="mb-0">Reason: @(_selected.BookingReason ?? "-")</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" disabled="@_starting" @onclick="ClosePopup">Close</button>
                        @if (_selected.Status == ReadyForConsultation)
                        {
                            <button class="btn btn-primary" disabled="@_starting" @onclick="StartConsultationAsync">Start consultation</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
</RoleGuard>

@code {
    private const string ReadyForConsultation = "ReadyForConsultation";
    private const string InConsultation = "InConsultation";

    private List<ReadyPatient> _patients = new();
    private ReadyPatient? _selected;
    private string _search = string.Empty;
    private string? _error;
    private string? _popupError;
    private bool _starting;
    private bool _loading = true;

    private IEnumerable<ReadyPatient> FilteredPatients => _patients.Where(x =>
        x.PatientName.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || x.PatientCode.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || x.AppointmentCode.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void OpenPopup(ReadyPatient patient)
    {
        _selected = patient;
        _popupError = null;
    }

    private void ClosePopup() => _selected = null;

    private async Task StartConsultationAsync()
    {
        _starting = true;
        _popupError = null;

        var result = await ExaminationApiService.StartConsultationAsync(_selected!.AppointmentId);
        _starting = false;

        if (!result.IsSuccess)
        {
            _popupError = result.ErrorMessage;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _selected = null;

        var result = await ExaminationApiService.GetReadyPatientsAsync();
        _loading = false;

        if (result.IsSuccess)
        {
            _patients = result.Data ?? new();
        }
        else
        {
            _error = result.ErrorMessage;
        }
    }
}
