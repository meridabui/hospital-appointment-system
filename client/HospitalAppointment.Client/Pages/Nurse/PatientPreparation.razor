@page "/nurse/patient-preparation/{AppointmentId:int}"
@using HospitalAppointment.Client.Models.Nurse
@inject NurseApiService NurseApi
@inject NavigationManager Navigation

<PageTitle>Chuẩn bị bệnh nhân</PageTitle>

<RoleGuard Role="Nurse" OnAuthorized="LoadAppointmentAsync">
    <div class="container py-4">
        <button class="btn btn-link ps-0 mb-3" @onclick="BackToDashboard"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</button>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        @if (isLoading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="text-muted mt-2">Đang tải thông tin bệnh nhân...</p></div>
        }
        else if (appointment is null)
        {
            <div class="alert alert-warning">Không tìm thấy lịch hẹn hoặc lịch không còn ở trạng thái chờ chuẩn bị.</div>
        }
        else
        {
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                <div><h2 class="fw-bold text-primary mb-1">Chuẩn bị bệnh nhân</h2><p class="text-muted mb-0">Xác nhận thông tin trước khi chuyển bệnh nhân cho bác sĩ.</p></div>
                <span class="badge bg-warning text-dark px-3 py-2">@appointment.Status</span>
            </div>

            <div class="row g-4">
                <div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body">
                    <h5 class="card-title">Thông tin bệnh nhân</h5><hr />
                    <dl class="row mb-0"><dt class="col-sm-5">Họ tên</dt><dd class="col-sm-7">@appointment.PatientName</dd><dt class="col-sm-5">Mã bệnh nhân</dt><dd class="col-sm-7">@appointment.PatientCode</dd><dt class="col-sm-5">Số điện thoại</dt><dd class="col-sm-7">@(appointment.PatientPhone ?? "Chưa có")</dd></dl>
                </div></div></div>
                <div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body">
                    <h5 class="card-title">Thông tin lịch khám</h5><hr />
                    <dl class="row mb-0"><dt class="col-sm-5">Mã lịch hẹn</dt><dd class="col-sm-7">@appointment.AppointmentCode</dd><dt class="col-sm-5">Bác sĩ</dt><dd class="col-sm-7">@appointment.DoctorName</dd><dt class="col-sm-5">Khoa</dt><dd class="col-sm-7">@appointment.DepartmentName</dd><dt class="col-sm-5">Thời gian</dt><dd class="col-sm-7">@appointment.SlotDate.ToString("dd/MM/yyyy") @appointment.StartTime.ToString("HH:mm") - @appointment.EndTime.ToString("HH:mm")</dd><dt class="col-sm-5">Check-in</dt><dd class="col-sm-7">@(appointment.CheckedInAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa ghi nhận")</dd></dl>
                </div></div></div>
                <div class="col-12"><div class="card border-0 shadow-sm"><div class="card-body">
                    <h5 class="card-title">Checklist chuẩn bị</h5><p class="text-muted small">Nurse kiểm tra nhận diện bệnh nhân, thông tin lịch khám và hoàn tất quy trình chuẩn bị trước khi bấm Mark Ready.</p>
                    <div class="form-check"><input class="form-check-input" type="checkbox" @bind="identityChecked" id="identityChecked" /><label class="form-check-label" for="identityChecked">Đã xác nhận đúng bệnh nhân</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" @bind="appointmentChecked" id="appointmentChecked" /><label class="form-check-label" for="appointmentChecked">Đã kiểm tra thông tin lịch khám</label></div>
                    <div class="form-check mb-4"><input class="form-check-input" type="checkbox" @bind="preparationCompleted" id="preparationCompleted" /><label class="form-check-label" for="preparationCompleted">Đã hoàn tất chuẩn bị theo quy trình</label></div>
                    @if (isCompleted)
                    {
                        <div class="alert alert-success mb-0">Bệnh nhân đã sẵn sàng khám. Bác sĩ có thể xem bệnh nhân trong danh sách chờ.</div>
                    }
                    else
                    {
                        <button class="btn btn-success" disabled="@(isSubmitting || !CanMarkReady)" @onclick="MarkReadyAsync"><i class="bi bi-check-circle me-1"></i>@(isSubmitting ? "Đang xử lý..." : "Mark Ready for Consultation")</button>
                    }
                </div></div></div>
            </div>
        }
    </div>
</RoleGuard>

@code {
    [Parameter] public int AppointmentId { get; set; }

    private NurseAppointmentDto? appointment;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool isCompleted;
    private bool identityChecked;
    private bool appointmentChecked;
    private bool preparationCompleted;

    private bool CanMarkReady => identityChecked && appointmentChecked && preparationCompleted;

    private async Task LoadAppointmentAsync()
    {
        isLoading = true;
        var result = await NurseApi.GetAppointmentDetailAsync(AppointmentId);
        if (result.IsSuccess && result.Data is not null)
        {
            appointment = result.Data;
        }
        else
        {
            errorMessage = result.ErrorMessage ?? "Không thể tải thông tin lịch hẹn.";
        }
        isLoading = false;
    }

    private async Task MarkReadyAsync()
    {
        if (appointment is null || !CanMarkReady || isSubmitting) return;

        isSubmitting = true;
        var result = await NurseApi.MarkReadyAsync(AppointmentId);
        isSubmitting = false;

        if (result.IsSuccess && result.Data is not null)
        {
            appointment.Status = result.Data.Status;
            appointment.ReadyAt = result.Data.ReadyAt;
            appointment.ReadyBy = result.Data.ReadyBy;
            isCompleted = true;
        }
        else
        {
            errorMessage = result.ErrorMessage ?? "Không thể đánh dấu bệnh nhân sẵn sàng khám.";
        }
    }

    private void BackToDashboard() => Navigation.NavigateTo("/nurse/dashboard");
}
