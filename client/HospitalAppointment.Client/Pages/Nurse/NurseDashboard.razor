@page "/nurse/dashboard"
@using HospitalAppointment.Client.Models.Nurse
@inject NurseApiService NurseApi
@inject NavigationManager Navigation

<PageTitle>Tiếp nhận bệnh nhân</PageTitle>

<RoleGuard Role="Nurse" OnAuthorized="LoadAppointmentsAsync">
    <div class="container-fluid py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <h2 class="fw-bold text-primary mb-1"><i class="bi bi-heart-pulse me-2"></i>Tiếp nhận và chuẩn bị bệnh nhân</h2>
                <p class="text-muted mb-0">Danh sách bệnh nhân đã check-in đang chờ chuẩn bị trước khi khám.</p>
            </div>
            <button class="btn btn-outline-primary" @onclick="LoadAppointmentsAsync" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="ClearError"></button>
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100"><div class="card-body">
                    <div class="text-muted small">Chờ chuẩn bị</div>
                    <div class="display-6 fw-bold text-primary">@appointments.Count</div>
                </div></div>
            </div>
            <div class="col-md-8">
                <div class="card border-0 shadow-sm h-100"><div class="card-body">
                    <label class="form-label small fw-semibold">Tìm kiếm bệnh nhân</label>
                    <input class="form-control" @bind="searchTerm" @bind:event="oninput" placeholder="Mã hẹn, mã bệnh nhân hoặc họ tên..." />
                </div></div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                @if (isLoading)
                {
                    <div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="text-muted mt-2 mb-0">Đang tải danh sách bệnh nhân...</p></div>
                }
                else if (FilteredAppointments.Count == 0)
                {
                    <div class="text-center py-5 text-muted"><i class="bi bi-clipboard-check" style="font-size:3rem"></i><p class="mt-2 mb-0">Không có bệnh nhân đang chờ chuẩn bị.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th class="ps-3">Mã hẹn</th><th>Bệnh nhân</th><th>Bác sĩ / Khoa</th><th>Giờ khám</th><th>Check-in</th><th class="text-center pe-3">Thao tác</th></tr></thead>
                            <tbody>
                                @foreach (var appointment in FilteredAppointments)
                                {
                                    <tr @key="appointment.AppointmentId">
                                        <td class="ps-3"><span class="badge bg-light text-dark border font-monospace">@appointment.AppointmentCode</span></td>
                                        <td><div class="fw-semibold">@appointment.PatientName</div><div class="small text-muted">@appointment.PatientCode · @(appointment.PatientPhone ?? "Chưa có SĐT")</div></td>
                                        <td><div>@appointment.DoctorName</div><div class="small text-muted">@appointment.DepartmentName</div></td>
                                        <td><div>@appointment.SlotDate.ToString("dd/MM/yyyy")</div><div class="small text-muted">@appointment.StartTime.ToString("HH:mm") - @appointment.EndTime.ToString("HH:mm")</div></td>
                                        <td>@(appointment.CheckedInAt?.ToLocalTime().ToString("HH:mm") ?? "—")</td>
                                        <td class="text-center pe-3"><button class="btn btn-sm btn-primary" @onclick="() => OpenPreparation(appointment.AppointmentId)"><i class="bi bi-clipboard2-pulse me-1"></i>Chuẩn bị</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</RoleGuard>

@code {
    private readonly List<NurseAppointmentDto> appointments = new();
    private string searchTerm = string.Empty;
    private string? errorMessage;
    private bool isLoading = true;

    private List<NurseAppointmentDto> FilteredAppointments => appointments.Where(appointment =>
        string.IsNullOrWhiteSpace(searchTerm) ||
        appointment.PatientName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        appointment.PatientCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        appointment.AppointmentCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

    private async Task LoadAppointmentsAsync()
    {
        isLoading = true;
        var result = await NurseApi.GetCheckedInAppointmentsAsync();
        appointments.Clear();
        if (result.IsSuccess && result.Data is not null)
        {
            appointments.AddRange(result.Data);
        }
        else
        {
            errorMessage = result.ErrorMessage ?? "Không thể tải danh sách bệnh nhân.";
        }
        isLoading = false;
    }

    private void OpenPreparation(int appointmentId) => Navigation.NavigateTo($"/nurse/patient-preparation/{appointmentId}");

    private void ClearError() => errorMessage = null;
}
